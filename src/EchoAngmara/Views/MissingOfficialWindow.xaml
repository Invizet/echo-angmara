<Window x:Class="EchoAngmara.Views.MissingOfficialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EchoAngmara"
        Title="{local:T missing.title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <StackPanel Margin="28,24">
        <TextBlock Text="{local:T missing.title}" FontFamily="{DynamicResource Display}" FontSize="24" Foreground="{StaticResource Gold}"/>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Text="{local:T missing.text}"/>
        <StackPanel Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}" Text="{local:T missing.step1}"/>
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}" Text="{local:T missing.step2}"/>
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}" Text="{local:T missing.step3}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Style="{StaticResource Ghost}" Content="{local:T missing.download}" Click="Download_Click" Margin="0,0,10,0"/>
            <Button Style="{StaticResource Ghost}" Content="{local:T missing.retry}" Click="Retry_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
