<Window x:Class="EchoAngmara.Views.MissingOfficialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Эхо Ангмара" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <StackPanel Margin="28,24">
        <TextBlock Text="Эхо Ангмара" FontFamily="{StaticResource Serif}" FontSize="26" Foreground="{StaticResource Gold}"/>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20">
            Русский лаунчер работает поверх официального Echoes of Angmar Launcher:
            берёт из него сохранённые логины и его же способом подключается к серверу.
            Официальный лаунчер не найден.
        </TextBlock>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Muted}">
            1. Скачайте и установите официальный лаунчер.<LineBreak/>
            2. Запустите его, войдите в аккаунт и отметьте «сохранять пароль».<LineBreak/>
            3. Вернитесь сюда и нажмите «Проверить снова».
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Style="{StaticResource Ghost}" Content="Скачать официальный лаунчер" Click="Download_Click" Margin="0,0,10,0"/>
            <Button Style="{StaticResource Ghost}" Content="Проверить снова" Click="Retry_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
